# ── Donna configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# In production (Railway/Fly), set these as deployment secrets instead.

# ── The brain (Anthropic / Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model used for high-quality drafting in your voice
DONNA_MODEL_DRAFT=claude-opus-4-8
# Cheaper/faster model for triage & classification
DONNA_MODEL_TRIAGE=claude-sonnet-5

# ── Who Donna works for ─────────────────────────────────────────────
# Your Telegram user id (numeric). Donna will only take commands from
# this id and will send you approvals/briefs here. Get it from @userinfobot.
OWNER_TELEGRAM_ID=123456789
# Your display name, used to sign drafts and personalize prompts.
OWNER_NAME=Your Name
# Your primary email address (the account Donna manages).
OWNER_EMAIL=you@example.com
# IANA timezone for briefs/scheduling, e.g. America/New_York, Asia/Manila
OWNER_TIMEZONE=Asia/Manila

# ── Telegram userbot (Telethon) ─────────────────────────────────────
# From https://my.telegram.org  -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Generated by `python scripts/setup_telegram.py` (a StringSession).
# Treat this like a password — it can act as your Telegram account.
TELEGRAM_SESSION=

# ── Google (Gmail + Calendar) ───────────────────────────────────────
# Path to the OAuth client secret JSON downloaded from Google Cloud.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# Generated by `python scripts/setup_google.py` (an OAuth token JSON blob).
# In production paste the token JSON as a single-line secret here instead.
GOOGLE_TOKEN_JSON=

# ── Behavior tuning ─────────────────────────────────────────────────
# Comms autonomy: "draft" (approve everything) or "auto_low" (auto-send
# low-stakes, ask on the rest). You chose to START at draft.
COMMS_AUTONOMY=draft
# Calendar autonomy: "auto" lets Donna book/reschedule without asking.
CALENDAR_AUTONOMY=auto
# How often (minutes) Donna sweeps the inbox for new mail.
INBOX_POLL_MINUTES=10
# Local time (HH:MM, 24h) to send the morning brief.
BRIEF_TIME=07:30
# A thread you've sent nothing on for this many days becomes a nudge.
NUDGE_AFTER_DAYS=3

# ── Storage ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///donna.db
